# Copy to .env.local and adjust.

# Production API origin. Leave empty in dev: Vite proxies /api to the Spring Boot backend on http://localhost:8080.
# If you set it to another origin, add that origin of the web app to the backend's app.cors.allowed-origins.
VITE_API_BASE_URL=

# false (default) = the app talks to the real backend (/api/v1/...) through the Vite proxy.
# true = answer API calls in the browser with the MSW fake backend in src/mocks (no backend needed).
#   Mock staff users: warehouse / finance / manager, password ReturnRight#2026.
#   Mock orders: ORD-100245 + priya.sharma@example.com, ORD-100198 + rahul.verma@example.com.
VITE_USE_MOCKS=false
